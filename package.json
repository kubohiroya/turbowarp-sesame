{
  "name": "@kubohiroya/turbowarp-sesame",
  "version": "0.3.0",
  "description": "A TurboWarp extension for the Candy House Sesame Web API.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-sesame#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-sesame.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-sesame/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "sesame",
    "smart-lock",
    "candy-house",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "app/",
    "config/",
    "docs/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "schemas"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.keyholder.config.ts && vite build --config vite.keyholder-sw.config.ts && vite build --config vite.app.config.ts && node scripts/build-sb3.mjs",
    "lint": "eslint src tests vite.config.ts vite.keyholder.config.ts vite.keyholder-sw.config.ts vite.app.config.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.mjs",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "repo:check": "node scripts/check-repo.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:dist": "pnpm run build && node scripts/check-dist.mjs",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/sb3-toolchain": "^0.18.0",
    "@kubohiroya/turbowarp-extension-manifest": "^0.4.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.9.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "jszip": "^3.10.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.4.0"
  },
  "gitHead": "e376264b11d86bfd13ff153fd899531dbdcdda8d",
  "x-turbowarp-source": {
    "revision": "e376264b11d86bfd13ff153fd899531dbdcdda8d",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
