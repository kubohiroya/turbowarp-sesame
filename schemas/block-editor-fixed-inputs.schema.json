{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kubohiroya.github.io/turbowarp-sesame/schemas/block-editor-fixed-inputs.schema.json",
  "title": "turbowarp-sesame fixed editing contracts",
  "$defs": {
    "getHistory": {
      "type": "object",
      "properties": {
        "PAGE": {
          "type": "number"
        },
        "LENGTH": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "sendCommand": {
      "type": "object",
      "properties": {
        "COMMAND": {
          "type": "string",
          "enum": ["lock", "unlock", "toggle"]
        }
      },
      "additionalProperties": false
    }
  }
}
